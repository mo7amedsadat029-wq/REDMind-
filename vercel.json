{
  "functions": {
    "api/index.js": {
      "includeFiles": "{configs,data,results,reports,PARAMETER_PROVENANCE.csv}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/figures/(.*)", "destination": "/api/index.js" },
    { "source": "/presentation-slides/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
