{
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{data,results}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/figures/(.*)", "destination": "/api/index.mjs" },
    { "source": "/presentation-slides/(.*)", "destination": "/api/index.mjs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
